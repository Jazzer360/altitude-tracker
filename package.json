{
  "name": "altitude",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run tests/stats.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-altitude \"vitest run tests/rules.emu.test.ts\"",
    "emulators": "firebase emulators:start --project demo-altitude",
    "dev:emu": "vite --mode emulator",
    "build:emu": "tsc -b && vite build --mode emulator",
    "test:e2e": "node tests/e2e.cjs"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "firebase": "^12.19.0",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^15.37.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
